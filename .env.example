# =====================================================================================
# Local configuration template. Copy to `.env` (git-ignored) and fill in.
#
# Where values live per environment:
#   local  -> this .env file (secrets may come from Key Vault instead, see below)
#   qa/prod -> non-secret values (URLs, flags): infra/<env>.bicepparam -> App Service settings
#              secrets: Azure Key Vault, loaded at startup via AZURE_KEY_VAULT_URL
#
# Key Vault secret names = setting name, lower-case, dashes instead of underscores:
#   AZURE_OPENAI_API_KEY -> azure-openai-api-key, MONGODB_URL -> mongodb-url
# Leave a secret blank here and it is read from Key Vault (blank values never override).
# Leave Azure keys blank everywhere to use Entra ID (`az login` locally, managed identity
# in Azure) — the recommended setup.
# =====================================================================================

# --- App ----------------------------------------------------------------------------------
APP_ENV=local
APP_NAME=oissa-rag-agent
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated (or JSON list) of allowed browser origins
# Add http://localhost:5173 for the oissaagent-ui dev server (admin RAG studio).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# Built-in chat page at /ui (C-230). Turn off when a separate front end is used.
UI_ENABLED=true
# Organisation name used in prompts ("knowledge assistant for <organisation>").
# TODO: set, e.g. "the World Bank Group"
ORGANISATION_NAME=the organisation
# One-line description of what the assistant covers (used for out-of-scope detection).
# TODO: e.g. "HR, finance and procurement policies"
ASSISTANT_SCOPE=

# --- Authentication & access control (C-048, C-154, C-192) --------------------------------
# none | api_key | entra | entra+api_key  (none = local only; ACLs not enforced)
AUTH_MODE=none
# [secret] Required in the X-API-Key header. Blank = no auth (local only!)
API_KEY=
# Principals granted to API-key callers ("*" = documents shared with everyone).
API_KEY_PRINCIPALS=*
# TODO: Entra tenant (directory) id
ENTRA_TENANT_ID=
# Accepted token audiences: the API app's client id and/or App ID URI (api://...).
ENTRA_API_AUDIENCE=
# Entra app role required to ingest/delete content (blank = any authenticated caller).
# TODO: e.g. "Ingestion.Write"
INGESTION_REQUIRED_ROLE=
# Entra app role required for the admin RAG studio (/api/v1/admin/*). Must match the UI's
# SA_Admin role. Blank = any authenticated caller.
ADMIN_REQUIRED_ROLE=SA_Admin
# Enforce document ACLs in every retriever (disable only for single-audience corpora).
ACL_ENFORCEMENT=true
# ACL applied to ingested documents that carry none ("*" = everyone in the org).
INGESTION_DEFAULT_ACL=*
# Requests per minute per user / API key (0 = unlimited). Shared across instances via Redis.
RATE_LIMIT_PER_MINUTE=60
# [secret] rediss://:<key>@<name>.redis.cache.windows.net:6380
REDIS_URL=

# --- Guardrails (C-156, C-194, C-195) -----------------------------------------------------
CONTENT_SAFETY_MODE=heuristic
# https://<name>.cognitiveservices.azure.com
CONTENT_SAFETY_ENDPOINT=
# [secret] blank = managed identity
CONTENT_SAFETY_API_KEY=
CONTENT_SAFETY_SEVERITY_THRESHOLD=4
BLOCK_OUTPUT_PII=true
LOG_PII_MASKING=true

# --- Secrets source -----------------------------------------------------------------------
# e.g. https://kvoissaragqa123abc.vault.azure.net — blank = no Key Vault
AZURE_KEY_VAULT_URL=

# --- RAG mode switch ----------------------------------------------------------------------
# Default strategy: semantic (vector) | hybrid (vector + BM25) | hybrid_graph (hybrid +
# knowledge graph) | graph | agentic | auto
RAG_MODE=hybrid
# Strategies this instance serves (others are rejected with 400)
RAG_ENABLED_MODES=semantic,hybrid,hybrid_graph,graph,agentic
# Allow `rag_mode` per request, to validate strategies side by side
RAG_ALLOW_MODE_OVERRIDE=true
# Allow `include_trace` to return retrieval steps/timings
RAG_ALLOW_TRACE=true
# Unified router (RAG_MODE=auto): question complexity -> mode, JSON (I-01).
RAG_ROUTER_MAP={"simple": "hybrid", "relationship": "graph", "global": "graph", "multi_step": "agentic"}
# I-03: retry a low-confidence answer with the next more capable enabled mode.
RAG_ESCALATION_ENABLED=false
RAG_MAX_ESCALATIONS=1

# --- Observability ------------------------------------------------------------------------
# [secret] blank = telemetry off
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Include the user's question in the `rag_answer` log (may contain PII)
LOG_QUESTION_TEXT=false

# --- Answer quality -----------------------------------------------------------------------
# LLM judge (groundedness, answer relevance, context relevance; 1-5):
#   off | request (when the request sets "evaluate": true) | always (every answer)
QUALITY_JUDGE=request
# Share of other answers judged in the background for dashboards (0.0-1.0)
QUALITY_JUDGE_SAMPLE_RATE=0.0

# --- Azure OpenAI (empty key => Managed Identity / az login) ------------------------------
# URL: https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# [secret] blank = Entra ID
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# Cheaper model for graph extraction / agent routing+grading (blank = chat deployment)
AZURE_OPENAI_UTILITY_DEPLOYMENT=gpt-4o-mini
# Answer deployments the admin RAG studio may compare (blank = chat, utility, fallback).
RAG_SELECTABLE_MODELS=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Must match the index's vector field; changing it requires a new index
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=64
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024

# --- MongoDB Atlas: chunks (vector + keyword search), knowledge graph, manifest ---------
# [secret] mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Vector and keyword search need Atlas Search indexes, so use an Atlas cluster (M0 works)
# or a local Atlas deployment (`atlas deployments setup --type local`).
MONGODB_URL=
MONGODB_DATABASE=knowledge
# Creates collections, indexes and the Atlas Search indexes (they build in the background)
MONGODB_CREATE_INDEXES_ON_STARTUP=true
VECTOR_STORE_PROVIDER=mongo
VECTOR_STORE_PROVIDERS=
MONGODB_CHUNKS_COLLECTION=rag_chunks
MONGODB_VECTOR_INDEX=rag_chunks_vector
MONGODB_SEARCH_INDEX=rag_chunks_text
MONGODB_TEXT_ANALYZER=lucene.english
# $vectorSearch numCandidates = top_k x factor (ANN recall vs latency)
MONGODB_NUM_CANDIDATES_FACTOR=10
# RETRIEVAL_MODE=semantic_hybrid: rerank the RRF-fused vector + BM25 candidates in the app.
# llm = utility model | cohere = RERANKER_* endpoint | none
MONGODB_SEMANTIC_RERANKER=llm
MONGODB_SEMANTIC_CANDIDATES=20
# vector | hybrid (keyword + vector) | semantic_hybrid (+ semantic reranker)
RETRIEVAL_MODE=hybrid

# --- Graph RAG: graph collections in MONGODB_DATABASE ---------------------------------------
GRAPH_STORE_PROVIDER=mongo
# Collections <prefix>_chunks / _entities / _relations / _claims / _sections / _documents
MONGODB_GRAPH_PREFIX=rag_graph
MONGODB_ENTITY_VECTOR_INDEX=rag_graph_entities_vector
GRAPH_CREATE_SCHEMA_ON_STARTUP=true
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITIES=10
GRAPH_MAX_RELATIONS=40
# Search mode: auto | local | path | hybrid | global | drift | dual | cypher (C6)
GRAPH_SEARCH_MODE=auto
# fan-out cap (G-40)
GRAPH_PER_ENTITY_LIMIT=15
GRAPH_MIN_RELATION_WEIGHT=0.0
# personalized PageRank ranking (G-42)
GRAPH_USE_PPR=true
GRAPH_INCLUDE_CLAIMS=true
GRAPH_GLOBAL_REPORTS=8
# only safe without per-user ACLs (G-44)
GRAPH_ALLOW_FREEFORM_CYPHER=false
# G-55
GRAPH_SEMANTIC_FALLBACK=true
# Extraction (C2) and resolution (C3)
GRAPH_ONTOLOGY_PATH=config/ontology.yaml
GRAPH_ALIASES_PATH=config/entity_aliases.yaml
GRAPH_CYPHER_TEMPLATES_PATH=config/cypher_templates.yaml
# G-13
GRAPH_GLEANING_ROUNDS=0
# G-12
GRAPH_EXTRACT_CLAIMS=false
# Communities (C4): built from facts visible to this ACL scope only (see communities.py)
GRAPH_COMMUNITY_ACL_SCOPE=*
GRAPH_COMMUNITY_LEVELS=3
GRAPH_COMMUNITY_MIN_SIZE=3

# --- Agentic RAG: LangGraph ---------------------------------------------------------------
# Tools the agent may use (A-07..A-15); add "web" only with WEB_SEARCH_* set
AGENTIC_TOOLS=vector,keyword,fetch_document,graph,graph_global,calculator,date_math
AGENTIC_MAX_ITERATIONS=3
AGENTIC_MIN_RELEVANT=2
# A-34
AGENTIC_MAX_TOOL_CALLS=12
# A-35 per run (0 = unlimited)
AGENTIC_MAX_TOKENS=60000
# A-36
AGENTIC_STEP_TIMEOUT_SECONDS=20.0
AGENTIC_MAX_SECONDS=90.0
# A-31
AGENTIC_MAX_REFLECTIONS=1
# A-45
AGENTIC_ALLOW_CLARIFY=false
# A-28..A-30
AGENTIC_GENERATE_AND_CHECK=true
# A-44
AGENTIC_REVIEW_ON_FAILED_CHECK=true
# A-06
AGENTIC_CHECKPOINTER=none
# none | memory | mongo (langgraph-checkpoint-mongodb)
# [secret] blank = MONGODB_URL
AGENTIC_CHECKPOINT_DSN=
# A-13 external web search (Tavily-compatible API). Off unless both are set AND "web" is a tool.
WEB_SEARCH_ENDPOINT=
# [secret]
WEB_SEARCH_API_KEY=

# --- Source documents ---------------------------------------------------------------------
# [secret] either a connection string, or the account URL + Entra ID
AZURE_STORAGE_CONNECTION_STRING=
# URL: https://<account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=documents
INGESTION_LOCAL_ROOT=./data
INGESTION_MAX_UPLOAD_MB=50
# File types /ingestion/upload and RAG Studio accept (checked by extension and content).
INGESTION_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.txt,.json,.xml,.png,.jpg,.jpeg
# Stores written by default: vector, graph (graph = one LLM call per chunk)
INGESTION_TARGETS=vector,graph
INGESTION_DOCUMENT_CONCURRENCY=4
INGESTION_DEFAULT_COLLECTION=default
# Queue-driven ingestion (scripts/ingestion_worker.py). Blank = API/CLI ingestion only.
# TODO: <name>.servicebus.windows.net
SERVICEBUS_NAMESPACE=
# [secret] alternative to managed identity
SERVICEBUS_CONNECTION_STRING=
INGESTION_QUEUE_NAME=ingestion

# --- Connectors (A4) — blank = connector disabled -----------------------------------------
# db:// and api:// definitions
SOURCES_CONFIG_PATH=config/sources.yaml
ACL_MAPPING_PATH=config/acl_mapping.yaml
# TODO
SHAREPOINT_TENANT_ID=
# TODO: app registration with Sites.Selected
SHAREPOINT_CLIENT_ID=
# [secret] Key Vault: sharepoint-client-secret
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_USE_MANAGED_IDENTITY=false
# TODO: https://<org>.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_USER=
# [secret] Key Vault: confluence-api-token
CONFLUENCE_API_TOKEN=
CONFLUENCE_DEFAULT_ACL=*
WEB_CRAWL_ENABLED=false
WEB_CRAWL_MAX_DEPTH=2
WEB_CRAWL_MAX_PAGES=200
WEB_CRAWL_DELAY_SECONDS=1.0
# [secret] e.g. "Authorization: Bearer ..."
WEB_CRAWL_AUTH_HEADER=

# --- Parsing (A5) -------------------------------------------------------------------------
# auto = docintel if configured
PDF_PARSER=auto
# TODO: https://<name>.cognitiveservices.azure.com
DOC_INTELLIGENCE_ENDPOINT=
# [secret] blank = managed identity
DOC_INTELLIGENCE_API_KEY=
# Images (C-075, C-078). Document Intelligence reads text (OCR) from PNG, JPEG, BMP, TIFF and
# HEIF; the vision deployment describes PNG, JPEG, GIF and WebP (photos, diagrams, charts).
# auto             OCR when supported; add a vision description when OCR finds little text
# or the format is vision-only
# docintel         OCR only        vision    description only
# docintel+vision  both            off       images are not ingested
IMAGE_PARSER=auto
# TODO: prebuilt-read (OCR text only, cheaper) or prebuilt-layout (also tables, headings,
# figures). PDFs always use prebuilt-layout.
DOC_INTELLIGENCE_IMAGE_MODEL=prebuilt-layout
# Below this many OCR characters an image is treated as a picture rather than a scan.
IMAGE_MIN_OCR_CHARS=30
# describe images/figures (C-078), e.g. gpt-4o or gpt-5.x (reasoning models are supported)
AZURE_OPENAI_VISION_DEPLOYMENT=
# Output tokens per image description (architecture diagrams need ~1,500-2,000).
VISION_MAX_TOKENS=1500
# PDFs parsed natively (no Document Intelligence): describe their embedded images with the
# vision deployment - diagrams and charts on text pages, and image-only (scanned) pages.
# Needs AZURE_OPENAI_VISION_DEPLOYMENT. Re-ingest with --force after enabling.
PDF_IMAGE_DESCRIPTIONS=true
# Images whose shorter side is below this many pixels are skipped (icons, logos).
PDF_IMAGE_MIN_PIXELS=150
# At most this many images described per PDF (0 = none); the rest are logged as over the limit.
PDF_MAX_IMAGES=30
# Images described at the same time (each takes ~15-20 s on a reasoning model).
VISION_CONCURRENCY=4
# transcribe audio/video (C-082)
AZURE_OPENAI_WHISPER_DEPLOYMENT=

# --- Cleaning & governance (A6) -----------------------------------------------------------
INGESTION_MAX_FILE_MB=100
INGESTION_MIN_TEXT_CHARS=50
INGESTION_MIN_PARSE_QUALITY=0.4
INGESTION_MAX_SENSITIVITY=confidential
INGESTION_INJECTION_ACTION=quarantine
PII_MODE=off
PII_ACTION=mask
# Azure AI Language (PII): https://<name>.cognitiveservices.azure.com
LANGUAGE_ENDPOINT=
# [secret]
LANGUAGE_API_KEY=
# 0 = keep everything
RETENTION_MAX_AGE_DAYS=0
NEAR_DUPLICATE_THRESHOLD=0.9
METADATA_RULES_PATH=config/metadata_rules.yaml

# --- Chunking (A8) & enrichment (B1) ------------------------------------------------------
CHUNK_MIN_TOKENS=40
# > 0 = parent-child chunking (S-01), e.g. 1500
CHUNK_PARENT_SIZE=0
CHUNK_PREPEND_HEADER=true
# semantic = S-02
CHUNK_STRATEGY=structure
# doc summary / type / tags (C-104, C-105)
ENRICH_PROFILE=false
# contextual retrieval (S-04)
ENRICH_CONTEXTUAL=false
# generated questions per chunk (S-06)
ENRICH_QUESTIONS=0
# chunk summaries (S-07)
ENRICH_SUMMARIES=false
# C-127
EMBEDDING_CACHE_ENABLED=true

# --- Ingestion bookkeeping (A10) ----------------------------------------------------------
# memory | mongo (shared, in MONGODB_DATABASE)
MANIFEST_STORE=memory
MANIFEST_COLLECTION=rag_ingestion_manifest
ZONES_STORE=local
ZONES_LOCAL_ROOT=.ragdata
# TODO: https://<account>.blob.core.windows.net
DATA_LAKE_ACCOUNT_URL=
DATA_LAKE_CONTAINER=rag-zones

# --- Retrieval / chunking tuning ----------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_RERANK_TOP_N=4
RETRIEVAL_MIN_SCORE=0.0
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Query understanding (A11) ------------------------------------------------------------
# One utility-model call per question: follow-up rewrite, intent, complexity, filters.
QUERY_ANALYSIS_ENABLED=true
GLOSSARY_PATH=config/glossary.yaml
# Document types the self-query filter may use (keep in sync with ingestion doc_type).
DOC_TYPES=policy,procedure,guideline,contract,faq,manual,report,other

# --- Semantic retrieval extras (Part B) ---------------------------------------------------
SEMANTIC_QUERY_TRANSFORM=none
SEMANTIC_MULTI_QUERY_COUNT=3
SEMANTIC_MMR=false
SEMANTIC_MMR_LAMBDA=0.7
SEMANTIC_EXPAND=none
# Knee-point cutoff (Kneedle): keep the passages before the sharp drop in reranked scores
RETRIEVAL_KNEE_CUTOFF=false
# 0-1: minimum distance from the score line that counts as a knee
RETRIEVAL_KNEE_SENSITIVITY=0.2
# Same cutoff on graph facts (PageRank) and community report scores
GRAPH_KNEE_CUTOFF=false
# e.g. 0.3 = newest docs score up to 30% higher
SEMANTIC_RECENCY_BOOST=0.0
SEMANTIC_RECENCY_HALF_LIFE_DAYS=365
# S-26: documents first (needs ENRICH_PROFILE summaries)
SEMANTIC_HIERARCHICAL=false
SEMANTIC_HIERARCHICAL_DOCS=5

# --- Reranking & context assembly (A12) ---------------------------------------------------
RERANKER=none
# Cohere rerank endpoint (Azure AI Foundry serverless)
RERANKER_ENDPOINT=
# [secret]
RERANKER_API_KEY=
RERANKER_MODEL=rerank-v3.5
CONTEXT_MAX_TOKENS=6000
CONTEXT_MIN_RELATIVE_SCORE=0.0
CONTEXT_REORDER=true

# --- Generation (A13) ---------------------------------------------------------------------
# Prompt version per prompt name, e.g. {"rag_answer": "v2"} (JSON).
PROMPT_VERSIONS=
# Secondary model for failover (C-190): another region / resource. Blank = no failover.
AZURE_OPENAI_FALLBACK_ENDPOINT=
# [secret]
AZURE_OPENAI_FALLBACK_API_KEY=
AZURE_OPENAI_FALLBACK_CHAT_DEPLOYMENT=

# --- Conversations (C-157, C-191) ---------------------------------------------------------
CONVERSATION_STORE=memory
CONVERSATION_MAX_TURNS=6
# https://<account>.documents.azure.com:443/
COSMOS_ENDPOINT=
# [secret] blank = managed identity
COSMOS_KEY=
COSMOS_DATABASE=rag
COSMOS_CONVERSATION_CONTAINER=conversations

# --- Answer cache (C-165) -----------------------------------------------------------------
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_SIMILARITY=0.95
ANSWER_CACHE_TTL_SECONDS=3600

# --- Evaluation (admin RAG studio) ---
EVAL_GOLDEN_SET_PATH=evals/golden_set.jsonl
EVAL_THRESHOLDS_PATH=evals/thresholds.yaml
