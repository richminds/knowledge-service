# =====================================================================================
# Configuration template. `.env` (git-ignored) is the deployed set; `.env.local` overrides
# it for local runs. Copy what you need and fill in.
#
# Every value can also be set as an environment variable (which wins over this file).
# Blank values are ignored, so `KEY=` never overrides a real value.
#
# LLM calls (chat + embeddings) go to the LLM gateway, through the API gateway, as the
# calling user. Identity comes from the headers the API gateway injects (AUTH_MODE=gateway).
# =====================================================================================

# --- App ----------------------------------------------------------------------------------
APP_ENV=prod
APP_NAME=oissa-rag-agent
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated (or JSON list) of allowed browser origins
# knowledge-ingest-ui (deployed, and its dev server on :5174).
CORS_ALLOW_ORIGINS=https://knowledge-ingest-ui.vercel.app,http://localhost:5174
# Built-in chat page at /ui (C-230). Turn off when a separate front end is used.
UI_ENABLED=false
# Organisation name used in prompts ("knowledge assistant for <organisation>").
ORGANISATION_NAME=RichMinds
# One-line description of what the assistant covers (used for out-of-scope detection).
# TODO: e.g. "HR, finance and procurement policies"
ASSISTANT_SCOPE=

# --- Authentication & access control (C-048, C-154) --------------------------------------
# gateway = trust X-User-ID / X-User-Email / X-User-Name / X-Account-ID / X-Is-Admin injected
#           by the API gateway (restrict this service to the gateway at the network level)
# none    = no auth, ACLs not enforced (local only)
AUTH_MODE=gateway
# Ingestion/deletion endpoints need X-Is-Admin (gateway mode). false = any signed-in user.
INGESTION_REQUIRES_ADMIN=false
# The admin RAG studio (/api/v1/admin/*) needs X-Is-Admin (gateway mode).
ADMIN_REQUIRES_ADMIN=true
# Enforce document ACLs in every retriever (disable only for single-audience corpora).
# Principals: "*", the caller's user id and account id.
ACL_ENFORCEMENT=true
# Retrieval only returns content ingested from the caller's app account (X-Account-ID,
# stored as account_id on every chunk), on top of the ACL. false = shared across accounts.
ACCOUNT_ISOLATION=true
# ACL applied to ingested documents that carry none ("*" = everyone in the org).
INGESTION_DEFAULT_ACL=*
# Requests per minute per user (0 = unlimited). Shared across instances via Redis.
RATE_LIMIT_PER_MINUTE=60
# [secret] redis://:<password>@<host>:6379
REDIS_URL=

# --- Guardrails (C-156, C-194, C-195) -----------------------------------------------------
# off | heuristic (prompt-injection phrases, leaked PII)
CONTENT_SAFETY_MODE=heuristic
BLOCK_OUTPUT_PII=true
LOG_PII_MASKING=true

# --- RAG mode switch ----------------------------------------------------------------------
# Default strategy: semantic (vector) | hybrid (vector + BM25) | hybrid_graph (hybrid +
# knowledge graph) | graph | agentic | auto
RAG_MODE=hybrid_graph
# Strategies this instance serves (others are rejected with 400)
RAG_ENABLED_MODES=semantic,hybrid,hybrid_graph,graph,agentic
# Allow `rag_mode` per request, to validate strategies side by side
RAG_ALLOW_MODE_OVERRIDE=true
# Allow `include_trace` to return retrieval steps/timings
RAG_ALLOW_TRACE=true
# Unified router (RAG_MODE=auto): question complexity -> mode, JSON (I-01).
RAG_ROUTER_MAP={"simple": "hybrid", "relationship": "graph", "global": "graph", "multi_step": "agentic"}
# I-03: retry a low-confidence answer with the next more capable enabled mode.
RAG_ESCALATION_ENABLED=false
RAG_MAX_ESCALATIONS=1

# --- Observability ------------------------------------------------------------------------
# Include the user's question in the `rag_answer` log (may contain PII)
LOG_QUESTION_TEXT=false

# --- Answer quality -----------------------------------------------------------------------
# LLM judge (groundedness, answer relevance, context relevance; 1-5):
#   off | request (when the request sets "evaluate": true) | always (every answer)
QUALITY_JUDGE=request
# Share of other answers judged in the background for dashboards (0.0-1.0)
QUALITY_JUDGE_SAMPLE_RATE=0.0

# --- LLM gateway --------------------------------------------------------------------------
# Chat and embedding calls go to <API_GATEWAY_URL>/api/llm with the caller's bearer token.
# The LLM gateway picks the model; nothing here names one.
API_GATEWAY_URL=https://api-gateway-two-nu.vercel.app
# Direct llm-gateway URL (e.g. http://localhost:8080); overrides API_GATEWAY_URL + /api/llm
LLM_GATEWAY_URL=https://api-gateway-two-nu.vercel.app/api/llm
# [secret] llm-gateway key (X-API-Key) for calls with no caller token: CLI ingestion,
# scripts, AUTH_MODE=none. Blank = those calls are refused by the gateway.
LLM_GATEWAY_API_KEY=
# Caller name in the gateway's per-caller stats (suffixed with the call purpose)
LLM_CALLER=knowledge-service
LLM_TIMEOUT_SECONDS=120.0
# Must match the gateway's embedding model; changing it requires a new vector index
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
GENERATION_TEMPERATURE=0.0
GENERATION_MAX_TOKENS=2048

# --- MongoDB Atlas: chunks (vector + keyword search), graph, manifest, conversations -----
# [secret] mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Vector and keyword search need Atlas Search indexes, so use an Atlas cluster (M0 works)
# or a local Atlas deployment (`atlas deployments setup --type local`).
# Legacy name RAG_MONGO_URI is still read; prefer MONGODB_URL.
MONGODB_URL=
MONGODB_DATABASE=knowledge_service
# Creates collections, indexes and the Atlas Search indexes (they build in the background)
MONGODB_CREATE_INDEXES_ON_STARTUP=true
VECTOR_STORE_PROVIDER=mongo
VECTOR_STORE_PROVIDERS=
MONGODB_CHUNKS_COLLECTION=rag_chunks
MONGODB_VECTOR_INDEX=rag_chunks_vector
MONGODB_SEARCH_INDEX=rag_chunks_text
MONGODB_TEXT_ANALYZER=lucene.english
# $vectorSearch numCandidates = top_k x factor (ANN recall vs latency)
MONGODB_NUM_CANDIDATES_FACTOR=10
# RETRIEVAL_MODE=semantic_hybrid: rerank the RRF-fused vector + BM25 candidates in the app.
# llm = utility model | cohere = RERANKER_* endpoint | none
MONGODB_SEMANTIC_RERANKER=llm
MONGODB_SEMANTIC_CANDIDATES=20
# vector | hybrid (keyword + vector) | semantic_hybrid (+ semantic reranker)
RETRIEVAL_MODE=hybrid

# --- Graph RAG ------------------------------------------------------------------------------
# neo4j - Neo4j Aura: native graph, Cypher templates and text-to-Cypher
# mongo - graph collections in MONGODB_DATABASE (no Cypher)
GRAPH_STORE_PROVIDER=neo4j
# Neo4j Aura: the values in the credentials .txt Aura gives you when the instance is
# created (console.neo4j.io). Legacy names: RAG_GRAPH_DB_URI / _USER / _PASSWORD / _DATABASE.
# neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
# [secret]
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_ENTITY_VECTOR_INDEX=rag_entity_embedding
NEO4J_QUERY_TIMEOUT_SECONDS=30
# mongo only: collections <prefix>_chunks / _entities / _relations / _claims / ...
MONGODB_GRAPH_PREFIX=rag_graph
MONGODB_ENTITY_VECTOR_INDEX=rag_graph_entities_vector
# Constraints / indexes (neo4j) or collections (mongo) created on startup
GRAPH_CREATE_SCHEMA_ON_STARTUP=true
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITIES=10
GRAPH_MAX_RELATIONS=40
# Search mode: auto | local | path | hybrid | global | drift | dual | cypher (C6)
GRAPH_SEARCH_MODE=auto
# fan-out cap (G-40)
GRAPH_PER_ENTITY_LIMIT=15
GRAPH_MIN_RELATION_WEIGHT=0.0
# personalized PageRank ranking (G-42)
GRAPH_USE_PPR=true
GRAPH_INCLUDE_CLAIMS=true
GRAPH_GLOBAL_REPORTS=8
# only safe without per-user ACLs (G-44)
GRAPH_ALLOW_FREEFORM_CYPHER=false
# G-55
GRAPH_SEMANTIC_FALLBACK=true
# Extraction (C2) and resolution (C3)
GRAPH_ONTOLOGY_PATH=config/ontology.yaml
GRAPH_ALIASES_PATH=config/entity_aliases.yaml
GRAPH_CYPHER_TEMPLATES_PATH=config/cypher_templates.yaml
# G-13
GRAPH_GLEANING_ROUNDS=0
# G-12
GRAPH_EXTRACT_CLAIMS=false
# Communities (C4): built from facts visible to this ACL scope only (see communities.py)
GRAPH_COMMUNITY_ACL_SCOPE=*
GRAPH_COMMUNITY_LEVELS=3
GRAPH_COMMUNITY_MIN_SIZE=3

# --- Agentic RAG: LangGraph ---------------------------------------------------------------
# Tools the agent may use (A-07..A-15)
AGENTIC_TOOLS=vector,keyword,fetch_document,graph,graph_global,graph_query,calculator,date_math
AGENTIC_MAX_ITERATIONS=3
AGENTIC_MIN_RELEVANT=2
# A-34
AGENTIC_MAX_TOOL_CALLS=12
# A-35 per run (0 = unlimited)
AGENTIC_MAX_TOKENS=60000
# A-36
AGENTIC_STEP_TIMEOUT_SECONDS=20.0
AGENTIC_MAX_SECONDS=90.0
# A-31
AGENTIC_MAX_REFLECTIONS=1
# A-45
AGENTIC_ALLOW_CLARIFY=false
# A-28..A-30
AGENTIC_GENERATE_AND_CHECK=true
# A-44
AGENTIC_REVIEW_ON_FAILED_CHECK=true
# A-06
AGENTIC_CHECKPOINTER=none
# none | memory | mongo (langgraph-checkpoint-mongodb)
# [secret] blank = MONGODB_URL
AGENTIC_CHECKPOINT_DSN=

# --- Source documents ---------------------------------------------------------------------
INGESTION_LOCAL_ROOT=./data
INGESTION_MAX_UPLOAD_MB=50
# File types /ingestion/upload and RAG Studio accept (checked by extension and content).
INGESTION_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.txt,.json,.xml
# Stores written by default: vector, graph (graph = one LLM call per chunk)
INGESTION_TARGETS=vector,graph
INGESTION_DOCUMENT_CONCURRENCY=4
INGESTION_DEFAULT_COLLECTION=default

# --- Connectors (A4) — blank = connector disabled -----------------------------------------
# db:// and api:// definitions
SOURCES_CONFIG_PATH=config/sources.yaml
ACL_MAPPING_PATH=config/acl_mapping.yaml
# TODO: https://<org>.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_USER=
# [secret]
CONFLUENCE_API_TOKEN=
CONFLUENCE_DEFAULT_ACL=*
WEB_CRAWL_ENABLED=false
WEB_CRAWL_MAX_DEPTH=2
WEB_CRAWL_MAX_PAGES=200
WEB_CRAWL_DELAY_SECONDS=1.0
# [secret] e.g. "Authorization: Bearer ..."
WEB_CRAWL_AUTH_HEADER=

# --- Parsing (A5) -------------------------------------------------------------------------
# PDFs are parsed natively (text only). Images and audio/video are not ingested: the LLM
# gateway is text-only, so there is no OCR, vision or speech model.
PDF_PARSER=native

# --- Cleaning & governance (A6) -----------------------------------------------------------
INGESTION_MAX_FILE_MB=100
INGESTION_MIN_TEXT_CHARS=50
INGESTION_MIN_PARSE_QUALITY=0.4
INGESTION_MAX_SENSITIVITY=confidential
INGESTION_INJECTION_ACTION=quarantine
# off | regex
PII_MODE=off
PII_ACTION=mask
# 0 = keep everything
RETENTION_MAX_AGE_DAYS=0
NEAR_DUPLICATE_THRESHOLD=0.9
METADATA_RULES_PATH=config/metadata_rules.yaml

# --- Chunking (A8) & enrichment (B1) ------------------------------------------------------
CHUNK_MIN_TOKENS=40
# > 0 = parent-child chunking (S-01), e.g. 1500
CHUNK_PARENT_SIZE=0
CHUNK_PREPEND_HEADER=true
# semantic = S-02
CHUNK_STRATEGY=structure
# doc summary / type / tags (C-104, C-105)
ENRICH_PROFILE=false
# contextual retrieval (S-04)
ENRICH_CONTEXTUAL=false
# generated questions per chunk (S-06)
ENRICH_QUESTIONS=0
# chunk summaries (S-07)
ENRICH_SUMMARIES=false
# C-127
EMBEDDING_CACHE_ENABLED=true

# --- Ingestion bookkeeping (A10) ----------------------------------------------------------
# memory | mongo (shared, in MONGODB_DATABASE)
MANIFEST_STORE=mongo
MANIFEST_COLLECTION=rag_ingestion_manifest
# off | local
ZONES_STORE=off
ZONES_LOCAL_ROOT=.ragdata

# --- Retrieval / chunking tuning ----------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_RERANK_TOP_N=4
RETRIEVAL_MIN_SCORE=0.0
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# --- Query understanding (A11) ------------------------------------------------------------
# One utility-model call per question: follow-up rewrite, intent, complexity, filters.
QUERY_ANALYSIS_ENABLED=true
GLOSSARY_PATH=config/glossary.yaml
# Document types the self-query filter may use (keep in sync with ingestion doc_type).
DOC_TYPES=policy,procedure,guideline,contract,faq,manual,report,other

# --- Semantic retrieval extras (Part B) ---------------------------------------------------
SEMANTIC_QUERY_TRANSFORM=none
SEMANTIC_MULTI_QUERY_COUNT=3
SEMANTIC_MMR=false
SEMANTIC_MMR_LAMBDA=0.7
SEMANTIC_EXPAND=none
# Knee-point cutoff (Kneedle): keep the passages before the sharp drop in reranked scores
RETRIEVAL_KNEE_CUTOFF=false
# 0-1: minimum distance from the score line that counts as a knee
RETRIEVAL_KNEE_SENSITIVITY=0.2
# Same cutoff on graph facts (PageRank) and community report scores
GRAPH_KNEE_CUTOFF=false
# e.g. 0.3 = newest docs score up to 30% higher
SEMANTIC_RECENCY_BOOST=0.0
SEMANTIC_RECENCY_HALF_LIFE_DAYS=365
# S-26: documents first (needs ENRICH_PROFILE summaries)
SEMANTIC_HIERARCHICAL=false
SEMANTIC_HIERARCHICAL_DOCS=5

# --- Reranking & context assembly (A12) ---------------------------------------------------
RERANKER=none
# Cohere-compatible rerank endpoint (POST /v2/rerank)
RERANKER_ENDPOINT=
# [secret]
RERANKER_API_KEY=
RERANKER_MODEL=rerank-v3.5
CONTEXT_MAX_TOKENS=6000
CONTEXT_MIN_RELATIVE_SCORE=0.0
CONTEXT_REORDER=true

# --- Generation (A13) ---------------------------------------------------------------------
# Prompt version per prompt name, e.g. {"rag_answer": "v2"} (JSON).
PROMPT_VERSIONS=

# --- Conversations (C-157, C-191) ---------------------------------------------------------
# memory | mongo (MONGODB_URL / MONGODB_DATABASE)
CONVERSATION_STORE=mongo
CONVERSATION_MAX_TURNS=6
MONGODB_CONVERSATIONS_COLLECTION=rag_conversations

# --- Answer cache (C-165) -----------------------------------------------------------------
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_SIMILARITY=0.95
ANSWER_CACHE_TTL_SECONDS=3600

# --- Evaluation (admin RAG studio) ---
EVAL_GOLDEN_SET_PATH=evals/golden_set.jsonl
EVAL_THRESHOLDS_PATH=evals/thresholds.yaml
