# =============================================================================
# Knowledge Service — Configuration Template
#
# USAGE:
#   cp .env.example .env
#   Fill in real values in .env  (never commit .env)
#
# Two prefixes, two concerns:
#   KNOWLEDGE_*  how the service itself is exposed     (app/config.py)
#   RAG_*        what the RAG pipeline does + which LLM Gateway it calls
#                                                       (rag/config.py)
#
# This service holds NO provider API key (no OpenAI/Anthropic/Groq/Gemini key
# anywhere here) — every embedding and chat call is made over HTTP to an LLM
# Gateway instance (RAG_GATEWAY_*). Point that at a deployed llm-gateway.
# =============================================================================


# ═════════════════════════════════════════════════════════════════════════════
# SERVICE  (KNOWLEDGE_*)
# ═════════════════════════════════════════════════════════════════════════════

KNOWLEDGE_HOST=0.0.0.0
KNOWLEDGE_PORT=8090
KNOWLEDGE_LOG_LEVEL=INFO
# "json" (default) — one JSON object per log line, request_id included on
# every line automatically (rag/log_context.py). "text" for a human reading a
# local terminal live.
KNOWLEDGE_LOG_FORMAT=json
# development | staging | production
KNOWLEDGE_ENVIRONMENT=development
# set false for a public production deploy
KNOWLEDGE_DOCS_ENABLED=true
# set when behind a path-prefixing proxy. Leave truly empty — an inline "# ..."
# comment after an empty value is NOT stripped by the dotenv parser and gets
# read as part of the value itself (this broke root_path and, with it,
# Swagger UI's OpenAPI fetch — see the openapi.json "servers" field if this
# ever regresses).
KNOWLEDGE_ROOT_PATH=

# ── Application credentials ──────────────────────────────────────────────────
# This service authenticates nobody. Every caller arrives through the API
# Gateway, which verifies the bearer token against auth-service, strips any
# identity headers the caller sent, and injects verified ones. This service
# reads X-User-ID / X-Account-ID / X-Is-Admin — see app/middleware/auth.py.
#
# KNOWLEDGE_API_KEYS is GONE, and so is RAG_JWT_SECRET. A static key was
# trusted for whatever account_id/user_id it asserted in the request body, so
# any holder of one bypassed the tenant isolation the rest of this service is
# built on. Local JWT validation went for a different reason: it needed the
# same signing key in three services, kept in sync by hand, and still could
# not see auth-service's revocation list. One service owns identity; the
# gateway asks it. Anything that must call this service with no end user
# behind it goes through the gateway like everything else.

# Browser origins (comma-separated, or * for any). Leave empty for
# service-to-service only.
# The knowledge-ingest-ui dev server runs on :5174 (see its vite.config.ts);
# its deployed Vercel origin is listed alongside it.
KNOWLEDGE_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://knowledge-ingest-ui-git-main-karpoora-sundarapandians-projects.vercel.app

# ── Structural guardrails ─────────────────────────────────────────────────────
KNOWLEDGE_MAX_QUESTION_LENGTH=4000
KNOWLEDGE_MAX_UPLOAD_FILES_PER_REQUEST=20
KNOWLEDGE_MAX_UPLOAD_FILE_SIZE_MB=50
KNOWLEDGE_MAX_METADATA_FILTER_KEYS=20
KNOWLEDGE_EXPOSE_CONFIG_ENDPOINT=true

# Header used for the request-ID that's echoed on every response and threads
# through every structured log line for this request (rag/log_context.py).
# Only needs changing behind a proxy that already mints its own ID header.
KNOWLEDGE_REQUEST_ID_HEADER=X-Request-ID


# ═════════════════════════════════════════════════════════════════════════════
# RAG PIPELINE + LLM GATEWAY  (RAG_*)
# ═════════════════════════════════════════════════════════════════════════════

# ── Auth ──────────────────────────────────────────────────────────────────────
# true  = a request must carry the gateway's verified identity headers or it is
#         rejected. user_id/account_id come ONLY from those headers, never from
#         the request body (app/dependencies.py::resolve_user_id).
# false = callers are anonymous with role "user" and the body is believed —
#         local development against a service with no gateway in front.
#
# There is no secret to configure. Trusting a header is sound only while the
# caller cannot set it, which the gateway's unconditional strip guarantees for
# traffic through the gateway and nothing else guarantees at all: restrict this
# service to the gateway (on Vercel, Deployment Protection) before exposing it.
RAG_AUTH_ENABLED=false

# ── LLM Gateway, reached through the API Gateway ──────────────────────────────
# This service holds no provider credential — every embedding/chat call is an
# HTTP request to an LLM Gateway.
#
# Point this at the API GATEWAY's /api/llm prefix, NOT at llm-gateway directly.
# The gateway strips the prefix and forwards, and that hop is what makes it the
# single enforcement point: authentication, per-user and per-account rate
# limits, budgets and usage metering all apply to RAG traffic the same way they
# apply to everything else. Straight at llm-gateway, this traffic arrives as one
# static service key and none of that can see it.
#
# Every call carries the CALLER's own token (rag/caller_context.py), so the
# gateway bills the user who caused it. A call with no user behind it — the CLI,
# a background job whose token has expired — has nothing to send and gets a 401.
RAG_GATEWAY_BASE_URL=https://api-gateway-two-nu.vercel.app/api/llm

RAG_GATEWAY_TIMEOUT_SECONDS=120.0

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
RAG_MONGO_URI=
RAG_MONGO_DB_NAME=knowledge_service
RAG_CHUNKS_COLLECTION=chunks
RAG_PARENTS_COLLECTION=parent_docs
RAG_INGESTION_JOBS_COLLECTION=ingestion_jobs
RAG_MONGO_MAX_POOL_SIZE=50
RAG_MONGO_MIN_POOL_SIZE=2
RAG_MONGO_CONNECT_TIMEOUT_MS=5000
RAG_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
RAG_MONGO_SOCKET_TIMEOUT_MS=30000

# ── Atlas Vector Search index ─────────────────────────────────────────────────
# Create once in Atlas UI or via ensure_indexes() on startup.
# Index spec: type=vectorSearch, path=embedding,
#             numDimensions=RAG_EMBEDDING_DIMENSIONS, similarity=RAG_VECTOR_SIMILARITY
RAG_VECTOR_INDEX_NAME=vector_index
RAG_VECTOR_SIMILARITY=cosine
# MUST match the dimension of whatever embedding model the LLM Gateway above
# actually serves (its own LLM_EMBEDDING_DIMENSIONS). Changing this
# invalidates every vector already stored.
#   openai text-embedding-3-small=1536, -3-large=3072
#   gemini-embedding-001 supports 768 / 1536 / 3072 (MRL truncation)
RAG_EMBEDDING_DIMENSIONS=1536

# ── Chunking ──────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_SEMANTIC_BREAKPOINT_PERCENTILE=25
RAG_CHILD_CHUNKS_PER_PARENT=3

# ── Retrieval ─────────────────────────────────────────────────────────────────
RAG_RETRIEVAL_TOP_K=8
RAG_RETRIEVAL_NUM_CANDIDATES=100
RAG_KEYWORD_SEARCH_FETCH_LIMIT=500

# ── Reranking ─────────────────────────────────────────────────────────────────
RAG_USE_CROSS_ENCODER_RERANKER=false
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Generation ────────────────────────────────────────────────────────────────
RAG_RAG_TEMPERATURE=0.0
RAG_RAG_MAX_TOKENS=2048

# ── Document loading ──────────────────────────────────────────────────────────
RAG_ENABLE_PDF_LAYOUT_EXTRACTION=true
RAG_ENABLE_PDF_OCR=false

# ── Uploaded-file storage (MongoDB GridFS — sole backend) ─────────────────────
RAG_FILE_STORE_GRIDFS_BUCKET=rag_files

# ── Security ──────────────────────────────────────────────────────────────────
RAG_USE_LLM_PROMPT_INJECTION_CLASSIFIER=false

# ── Evaluation ────────────────────────────────────────────────────────────────
# Options: local (default), ragas, deepeval, llm
RAG_ADVANCED_EVAL_PROVIDER=local

# ── Graph DB / Hybrid RAG ──────────────────────────────────────────────────────
# Backends: mongo (recommended — shared MongoDB, no new service/creds),
# neo4j (needs URI/USER/PASSWORD), arangodb/falkordb (reserved, no-op).
RAG_GRAPH_RETRIEVAL_ENABLED=false
RAG_GRAPH_RETRIEVAL_TOP_K=8
RAG_GRAPH_DB_BACKEND=mongo
RAG_GRAPH_CHUNKS_COLLECTION=graph_chunks
# neo4j backend only:
RAG_GRAPH_DB_URI=
RAG_GRAPH_DB_USER=
RAG_GRAPH_DB_PASSWORD=
RAG_GRAPH_DB_DATABASE=

# ── Free web search (hybrid RAG, 4th leg) ──────────────────────────────────────
# Adds a web-search retrieval leg (Tavily free tier) alongside vector +
# keyword + graph search. Results pass through the same rerank/knee-point/
# prompt-injection safety filter as internal chunks before reaching the LLM.
RAG_WEB_SEARCH_ENABLED=false
RAG_WEB_SEARCH_TOP_K=3
# Not RAG_-prefixed on purpose — read directly via os.getenv, see rag/web_search.py.
TAVILY_API_KEY=
