// Application Insights (Log Analytics) queries for the RAG agent.
// Paste into App Insights > Logs, or pin to a dashboard / Azure Workbook.
// Custom metrics land in `customMetrics`; structured logs in `traces` (fields in customDimensions).

// 1. Answer quality per RAG mode (LLM judge, 1-5) - last 7 days
customMetrics
| where timestamp > ago(7d) and name == "rag.quality.score"
| extend mode = tostring(customDimensions["rag.mode"]),
         metric = tostring(customDimensions["quality.metric"]),
         evaluator = tostring(customDimensions["evaluator"])
| where evaluator == "llm_judge"
| summarize avg_score = sum(valueSum) / sum(valueCount), samples = sum(valueCount) by mode, metric
| order by mode, metric

// 2. Confidence mix per mode (share of high / medium / low answers)
customMetrics
| where timestamp > ago(7d) and name == "rag.answers"
| extend mode = tostring(customDimensions["rag.mode"]), confidence = tostring(customDimensions["confidence"])
| summarize answers = sum(valueSum) by mode, confidence
| evaluate pivot(confidence, sum(answers))

// 3. Latency percentiles per mode and operation
customMetrics
| where timestamp > ago(24h) and name == "rag.request.duration"
| extend mode = tostring(customDimensions["rag.mode"]), op = tostring(customDimensions["rag.operation"])
| summarize avg_ms = sum(valueSum) / sum(valueCount), max_ms = max(valueMax) by mode, op

// 4. Slowest RAG steps (vector_search, graph_traversal, grade, rewrite, ...)
customMetrics
| where timestamp > ago(24h) and name == "rag.step.duration"
| summarize avg_ms = sum(valueSum) / sum(valueCount), calls = sum(valueCount)
    by step = tostring(customDimensions["rag.step"])
| order by avg_ms desc

// 5. Token usage (cost driver) by purpose and model
customMetrics
| where timestamp > ago(7d) and name == "rag.llm.tokens"
| summarize tokens = sum(valueSum)
    by purpose = tostring(customDimensions["llm.purpose"]), model = tostring(customDimensions["llm.model"]),
       type = tostring(customDimensions["token.type"])
| order by tokens desc

// 6. Low-confidence answers to review (one row per answer)
traces
| where timestamp > ago(7d) and message == "rag_answer"
| extend d = customDimensions
| where tostring(d.confidence) == "low"
| project timestamp, response_id = tostring(d.response_id), mode = tostring(d.rag_mode),
          answered = tostring(d.answered), contexts = toint(d.contexts),
          groundedness = toint(d.groundedness), citation_coverage = todouble(d.citation_coverage)
| order by timestamp desc

// 7. User feedback joined with the answer it rates
traces
| where timestamp > ago(30d) and message == "user_feedback"
| extend response_id = tostring(customDimensions.response_id), rating = tostring(customDimensions.rating),
         comment = tostring(customDimensions.comment)
| join kind=leftouter (
    traces
    | where message == "rag_answer"
    | extend response_id = tostring(customDimensions.response_id),
             mode = tostring(customDimensions.rag_mode), confidence = tostring(customDimensions.confidence),
             groundedness = toint(customDimensions.groundedness)
    | project response_id, mode, confidence, groundedness
  ) on response_id
| project timestamp, rating, comment, mode, confidence, groundedness, response_id
| order by timestamp desc

// 8. Does our confidence label agree with users? (thumbs-down rate by confidence)
traces
| where timestamp > ago(30d) and message == "user_feedback"
| extend response_id = tostring(customDimensions.response_id), rating = tostring(customDimensions.rating)
| join kind=inner (
    traces | where message == "rag_answer"
    | extend response_id = tostring(customDimensions.response_id), confidence = tostring(customDimensions.confidence)
    | project response_id, confidence
  ) on response_id
| summarize feedback = count(), thumbs_down_rate = round(100.0 * countif(rating == "down") / count(), 1)
    by confidence

// 9. End-to-end trace of one answer (all RAG step spans + Azure dependency calls)
//    Replace the id with a response_id / X-Request-ID from a chat response.
let rid = "<response_id>";
let op = toscalar(traces | where customDimensions.response_id == rid | project operation_Id | take 1);
union requests, dependencies, traces
| where operation_Id == op
| project timestamp, itemType, name = coalesce(name, message), duration, success
| order by timestamp asc
